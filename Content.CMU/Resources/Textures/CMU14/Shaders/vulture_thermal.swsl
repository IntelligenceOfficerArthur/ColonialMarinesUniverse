// Vulture thermal optics, world pass. Starts from the fighter sensor's luminance remap, but keeps the scene as a
// dim grey backdrop (capped below the heat colours) so warm bodies, drawn afterwards, are what the eye goes to.
uniform sampler2D SCREEN_TEXTURE;

uniform highp float low_cut;
uniform highp float high_cut;
uniform highp float floor_level;
uniform highp float ceiling_level;

void fragment() {
    highp vec4 source = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
    highp float cold = smoothstep(low_cut, high_cut, luminance);
    highp float level = floor_level + (ceiling_level - floor_level) * cold;
    COLOR = vec4(vec3(level), 1.0);
}
