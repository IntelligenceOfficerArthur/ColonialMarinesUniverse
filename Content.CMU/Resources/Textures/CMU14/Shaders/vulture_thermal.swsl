// Vulture thermal optics, world pass. Starts from the fighter sensor's luminance remap, but keeps the scene as a
// dim grey backdrop (capped below the heat colours) so warm bodies, drawn afterwards, are what the eye goes to.
// A local contrast boost on top keeps floors, walls and objects readable even when the scene is evenly lit.
uniform sampler2D SCREEN_TEXTURE;

uniform highp float low_cut;
uniform highp float high_cut;
uniform highp float floor_level;
uniform highp float ceiling_level;
uniform highp float detail_gain;
uniform highp float detail_radius;

highp float luma(highp vec2 uv) {
    return dot(zTextureSpec(SCREEN_TEXTURE, uv).rgb, vec3(0.2126, 0.7152, 0.0722));
}

void fragment() {
    highp vec2 s = SCREEN_PIXEL_SIZE * detail_radius;
    highp float center = luma(UV);
    highp float around = (
        luma(UV + vec2(s.x, 0.0)) + luma(UV - vec2(s.x, 0.0)) +
        luma(UV + vec2(0.0, s.y)) + luma(UV - vec2(0.0, s.y)) +
        luma(UV + s) + luma(UV - s) +
        luma(UV + vec2(s.x, -s.y)) + luma(UV + vec2(-s.x, s.y))) / 8.0;

    highp float cold = smoothstep(low_cut, high_cut, center);
    highp float level = floor_level + (ceiling_level - floor_level) * cold + (center - around) * detail_gain;

    // Detail may brighten past the backdrop ceiling a little, but never to heat-silhouette brightness.
    COLOR = vec4(vec3(clamp(level, 0.0, ceiling_level + 0.2)), 1.0);
}
